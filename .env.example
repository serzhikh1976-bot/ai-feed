# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git / архивы — там секретные ключи.

# Какой AI-провайдер использовать: openai | gemini | mock
# mock — заглушка для локальной проверки пайплайна БЕЗ реальных затрат на API
# (см. README, раздел "Тестирование без реальных AI-затрат"). Никогда не использовать в проде.
AI_PROVIDER=mock

# Нужен, если AI_PROVIDER=openai
OPENAI_API_KEY=

# Нужен, если AI_PROVIDER=gemini
GOOGLE_AI_API_KEY=

# Необязательно — конкретная модель. Если не задано, используется дефолт из ТЗ:
# gpt-4o-mini для openai, gemini-2.5-flash для gemini.
AI_MODEL=

# Необязательно — если задано, ИИ жёстко использует этот бренд для всех товаров
# в прогоне (сценарий А из ТЗ 3.2). Если не задано — ИИ ищет бренд в тексте сам.
DEFAULT_BRAND=

PORT=3000
